# Stability AI API Configuration
STABILITY_API_KEY=your_stability_api_key_here
STABILITY_HOST=grpc.stability.ai:443

# Optional: Currency API (uses free exchangerate-api.com by default)
# CURRENCY_API_URL=https://api.exchangerate-api.com/v4/latest/USD

# Gemini (Thumbnail audit + prompt generation)
# NOTE: If you see HTTP 429 with limits shown as 0, your API key/project has no available quota.
# You may need to enable billing / increase quota in Google AI Studio for Gemini API.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model name.
# You can run a model listing via the SDK (ListModels) to see what's available for your key.
# Common examples: models/gemini-flash-latest, models/gemini-pro-latest, models/gemini-2.5-flash
GEMINI_MODEL_NAME=models/gemini-flash-latest
