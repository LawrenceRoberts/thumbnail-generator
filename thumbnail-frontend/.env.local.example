# Backend API URL used by the Next.js API proxy route (/api/generate)
#
# In production (Vercel), set this to your public backend URL, e.g.
# BACKEND_URL=https://your-fly-app.fly.dev
BACKEND_URL=http://localhost:8000

# Add other environment variables as needed

# PostgreSQL connection string (server-side). Used by Prisma.
# Example: postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

# Supabase (server-side).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# IMPORTANT: service role key must never be exposed to the browser.
# Only use in Server Actions / Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
